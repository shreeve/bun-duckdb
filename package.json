{
  "name": "duckdb-bun",
  "version": "0.4.0",
  "description": "Efficient DuckDB driver for Bun, using pure FFI",
  "type": "module",
  "sideEffects": false,
  "main": "./lib/duckdb.mjs",
  "types": "./lib/duckdb.d.ts",
  "exports": {
    ".": {
      "types": "./lib/duckdb.d.ts",
      "import": "./lib/duckdb.mjs",
      "default": "./lib/duckdb.mjs"
    },
    "./async": {
      "types": "./lib/async/index.d.ts",
      "import": "./lib/async/index.mjs",
      "default": "./lib/async/index.mjs"
    }
  },
  "files": [
    "lib/duckdb.mjs",
    "lib/duckdb.d.ts",
    "lib/duckdb-shim.c",
    "lib/Makefile",
    "lib/libduckdb-shim-linux-x64.so",
    "lib/libduckdb-shim-linux-arm64.so",
    "lib/libduckdb-shim-darwin-x64.dylib",
    "lib/libduckdb-shim-darwin-arm64.dylib",
    "lib/async/index.mjs",
    "lib/async/index.d.ts",
    "lib/async/worker.mjs",
    "lib/async/protocol.mjs",
    "lib/async/protocol.d.ts",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:shim": "make -C lib",
    "test": "bun test",
    "example:basic": "bun examples/basic.mjs",
    "example:prepared": "bun examples/prepared.mjs",
    "example:appender": "bun examples/appender.mjs",
    "example:iterate": "bun examples/iterate.mjs",
    "example:async": "bun examples/async.mjs",
    "bench:async": "bun bench/async-vs-sync.mjs"
  },
  "keywords": [
    "duckdb",
    "bun",
    "ffi",
    "bun-ffi",
    "embedded-database",
    "sql",
    "analytical-database",
    "olap"
  ],
  "author": "Steve Shreeve <steve.shreeve@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreeve/duckdb-bun.git"
  },
  "bugs": {
    "url": "https://github.com/shreeve/duckdb-bun/issues"
  },
  "homepage": "https://github.com/shreeve/duckdb-bun#readme",
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
